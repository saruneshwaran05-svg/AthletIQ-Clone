{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "⚡ Run AthletIQ Server (http://127.0.0.1:8000)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/SportSphere;${workspaceFolder}",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "subProcess": false,
            "justMyCode": true
        },
        {
            "name": "🌐 Open Chrome Browser (http://127.0.0.1:8000)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:8000",
            "webRoot": "${workspaceFolder}/SportSphere"
        },
        {
            "name": "🐍 Python Debugger: Uvicorn Direct",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/SportSphere",
            "console": "integratedTerminal",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "subProcess": false
        }
    ],
    "compounds": [
        {
            "name": "🚀 Launch Full AthletIQ App (Server + Chrome)",
            "configurations": [
                "⚡ Run AthletIQ Server (http://127.0.0.1:8000)",
                "🌐 Open Chrome Browser (http://127.0.0.1:8000)"
            ]
        }
    ]
}