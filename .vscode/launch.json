{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "⚡ Run AthletIQ Server (http://127.0.0.1:8000)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/SportSphere;${workspaceFolder}"
            },
            "subProcess": true
        },
        {
            "name": "🌐 Open Chrome Browser (http://127.0.0.1:8000)",
            "type": "chrome",
            "request": "launch",
            "url": "http://127.0.0.1:8000",
            "webRoot": "${workspaceFolder}/SportSphere"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "🚀 Launch Full AthletIQ App (Server + Chrome)",
            "configurations": [
                "⚡ Run AthletIQ Server (http://127.0.0.1:8000)",
                "🌐 Open Chrome Browser (http://127.0.0.1:8000)"
            ]
        }
    ]
}